        <CheatEntry>
          <ID>290</ID>
          <Description>"[Script] Max stats + unlock all limits (ALL characters)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
local base = getAddress("ff7_en.exe")+0x9BFD38
local records = {0x54,0xD8,0x15C,0x1E0,0x264,0x2E8,0x36C,0x3F0,0x474}
for _,r in ipairs(records) do
  local p = base + r
  -- stats STR..LCK
  for i=2,7 do writeByte(p+i, 255) end
  writeByte(p+0x0E, 4)       -- limit level
  writeByte(p+0x0F, 255)     -- limit bar
  writeSmallInteger(p+0x22, 0x02DB) -- all limits
  writeSmallInteger(p+0x24, 65535) -- kills
  writeSmallInteger(p+0x26, 255)
  writeSmallInteger(p+0x28, 255)
  writeSmallInteger(p+0x2A, 255)
  -- fill HP/MP to max
  local maxHp = readSmallInteger(p+0x38) or 9999
  local maxMp = readSmallInteger(p+0x3A) or 999
  writeSmallInteger(p+0x2C, maxHp)
  writeSmallInteger(p+0x30, maxMp)
end
showMessage("Maxed stats + all limits for all 9 character records. Save in-game.")
[DISABLE]
</AssemblerScript>
        </CheatEntry>

      </CheatEntries>
    </CheatEntry>

