        <CheatEntry>
          <ID>520</ID>
          <Description>"[Script] Fill 6 max gold chocobos"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
local base = getAddress("ff7_en.exe")+0x9BFD38
local offs = {0xDC4,0xDD4,0xDE4,0xDF4,0x1084,0x1094}
for i,o in ipairs(offs) do
  local p = base + o
  writeSmallInteger(p+0, 255) -- sprint
  writeSmallInteger(p+2, 255)
  writeSmallInteger(p+4, 255) -- speed
  writeSmallInteger(p+6, 255)
  writeByte(p+8, 100)  -- accel
  writeByte(p+9, 100)  -- coop
  writeByte(p+10, 100) -- intel
  writeByte(p+11, 0)   -- personality
  writeByte(p+12, 0)
  writeByte(p+13, 0)   -- races
  writeByte(p+14, (i-1)%2) -- sex
  writeByte(p+15, 4)   -- gold
  writeSmallInteger(base+0xEE8+(i-1)*2, 9999)
end
writeByte(base+0xCFC, 6)
writeByte(base+0xCFD, 6)
writeByte(base+0xCFF, 0x3F)
writeByte(base+0xD00, 0)
showMessage("6 gold chocobos filled. Visit the ranch / save to confirm.")
[DISABLE]
</AssemblerScript>
