          <Address>ff7_en.exe+9BFD38+504</Address>
        </CheatEntry>

        <CheatEntry>
          <ID>310</ID>
          <Description>"[Script] Set all owned item quantities to 99"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
local base = getAddress("ff7_en.exe")+0x9BFD38+0x4FC
local n = 0
for i=0,319 do
  local raw = readSmallInteger(base + i*2) or 0xFFFF
  local id = raw &amp; 0x1FF
  if id ~= 0x1FF and raw ~= 0xFFFF then
    writeSmallInteger(base + i*2, ((99 &lt;&lt; 9) &amp; 0xFE00) | id)
    n = n + 1
  end
end
showMessage(string.format("Set qty=99 on %d item slots.", n))
[DISABLE]
</AssemblerScript>
        </CheatEntry>

        <CheatEntry>
          <ID>311</ID>
          <Description>"[Script] Fill inventory: Potion..GuideBook + all weapons/armor/acc ×99"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
-- Fills slots 0.. with consecutive item IDs (skips unused 105-127 gap for simplicity: writes 0-104 then 128-319)
local base = getAddress("ff7_en.exe")+0x9BFD38+0x4FC
local slot = 0
local function put(id)
  if slot &gt;= 320 then return end
  writeSmallInteger(base + slot*2, ((99 &lt;&lt; 9) &amp; 0xFE00) | (id &amp; 0x1FF))
  slot = slot + 1
end
for id=0,104 do put(id) end
for id=128,319 do put(id) end
while slot &lt; 320 do
  writeSmallInteger(base + slot*2, 0xFFFF)
  slot = slot + 1
end
showMessage("Filled inventory with all real items ×99. Open/close menu to refresh.")
[DISABLE]
</AssemblerScript>
        </CheatEntry>

      </CheatEntries>
    </CheatEntry>

