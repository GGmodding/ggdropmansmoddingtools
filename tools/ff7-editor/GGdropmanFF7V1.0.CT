        <CheatEntry>
          <ID>410</ID>
          <Description>"[Script] Master all owned materia (AP=0xFFFFFF)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
local base = getAddress("ff7_en.exe")+0x9BFD38+0x77C
local n = 0
for i=0,199 do
  local p = base + i*4
  local id = readByte(p)
  if id and id ~= 0xFF then
    writeBytes(p+1, {0xFF, 0xFF, 0xFF})
    n = n + 1
  end
end
showMessage(string.format("Mastered %d materia.", n))
[DISABLE]
</AssemblerScript>
        </CheatEntry>

        <CheatEntry>
          <ID>411</ID>
          <Description>"[Script] Add all materia (mastered) into inventory"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
local ids = {
  0x00,0x01,0x02,0x03,0x04,0x05,0x06,0x07,0x08,0x09,0x0A,0x0B,0x0C,0x0D,0x0E,0x0F,
  0x10,0x11,0x12,0x13,0x14,0x15,0x17,0x18,0x19,0x1A,0x1B,0x1C,0x1D,0x1E,0x1F,
  0x20,0x21,0x22,0x23,0x24,0x25,0x27,0x28,0x29,0x2A,0x2B,0x2C,0x30,
  0x31,0x32,0x33,0x34,0x35,0x36,0x37,0x38,0x39,0x3A,0x3B,0x3C,0x3D,0x3E,
  0x40,0x41,0x44,0x45,0x46,0x47,0x48,0x49,
  0x4A,0x4B,0x4C,0x4D,0x4E,0x4F,0x50,0x51,0x52,0x53,0x54,0x55,0x56,0x57,0x58,0x59,0x5A
}
local base = getAddress("ff7_en.exe")+0x9BFD38+0x77C
for i=0,199 do
  writeBytes(base+i*4, {0xFF, 0xFF, 0xFF, 0xFF})
end
for i,id in ipairs(ids) do
  local p = base + (i-1)*4
  writeBytes(p, {id, 0xFF, 0xFF, 0xFF})
end
showMessage(string.format("Added %d mastered materia.", #ids))
[DISABLE]
</AssemblerScript>
        </CheatEntry>

