<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>

    <CheatEntry>
      <ID>1</ID>
      <Description>"=== GGdropmans FF7 Editor (Steam Classic) ==="</Description>
      <Options moHideChildren="1"/>
      <Color>00C08040</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>

        <CheatEntry>
          <ID>2</ID>
          <Description>"README — how to use"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{
GGdropmans FF7 Cheat Table
==========================
Process: ff7_en.exe  (Steam classic / 2013 remaster)
NOT for Remake, Rebirth, or the 2026 "Steam Edition" wrapper unless it still launches ff7_en.exe.
Donate / tip: https://paypal.me/kd19902
Discord: https://discord.gg/PTwyDTFyR

1. Start FF7 (English Steam build)
2. Open this .CT in Cheat Engine
3. Attach to ff7_en.exe
4. Edit values below (field/menu stats use the in-RAM savemap)

If numbers look wrong after a game update:
- Search your current Gil as Exact Value, 4 Bytes
- Note the address, then set Savemap Base = GilAddress - 0xB7C
- Or edit the "Savemap Base" entry below

Savemap offsets match the browser editor / Black Chocobo wiki.
}
[ENABLE]
[DISABLE]
</AssemblerScript>
        </CheatEntry>

        <CheatEntry>
          <ID>3</ID>
          <Description>"Savemap Base (gil = base+B7C)"</Description>
          <ShowAsHex>1</ShowAsHex>
          <VariableType>4 Bytes</VariableType>
          <Address>ff7_en.exe+9BFD38</Address>
          <Color>00808080</Color>
        </CheatEntry>

      </CheatEntries>
    </CheatEntry>

    <!-- ===================== PARTY / GIL ===================== -->
    <CheatEntry>
      <ID>10</ID>
      <Description>"Gil &amp; Party"</Description>
      <Options moHideChildren="1" moManualExpandCollapse="1"/>
      <Color>0040C080</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>

        <CheatEntry>
          <ID>11</ID>
          <Description>"Gil"</Description>
          <VariableType>4 Bytes</VariableType>
          <Address>ff7_en.exe+9C08B4</Address>
        </CheatEntry>

        <CheatEntry>
          <ID>12</ID>
          <Description>"Party slot 1 (0=Cloud … 7=Vincent 8=Cid 10=Sephiroth FF=empty)"</Description>
          <ShowAsHex>1</ShowAsHex>
          <VariableType>Byte</VariableType>
          <Address>ff7_en.exe+9BFD38+4F8</Address>
        </CheatEntry>

        <CheatEntry>
          <ID>13</ID>
          <Description>"Party slot 2"</Description>
          <ShowAsHex>1</ShowAsHex>
          <VariableType>Byte</VariableType>
          <Address>ff7_en.exe+9BFD38+4F9</Address>
        </CheatEntry>

        <CheatEntry>
          <ID>14</ID>
          <Description>"Party slot 3"</Description>
          <ShowAsHex>1</ShowAsHex>
          <VariableType>Byte</VariableType>
          <Address>ff7_en.exe+9BFD38+4FA</Address>
        </CheatEntry>

        <CheatEntry>
          <ID>15</ID>
          <Description>"[Script] Max Gil (99999999)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if getAddressSafe("ff7_en.exe") == nil then
  showMessage("Attach to ff7_en.exe first")
  error("no process")
end
writeInteger(getAddress("ff7_en.exe")+0x9C08B4, 99999999)
[DISABLE]
</AssemblerScript>
        </CheatEntry>

        <CheatEntry>
          <ID>16</ID>
          <Description>"[Script] Enable Sephiroth (sets Vincent id=0x0A, PHS bit, party slot 3)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
local base = getAddress("ff7_en.exe")+0x9BFD38
-- Vincent/Sephiroth character id at record 7 (0x3F0 + 0x00)
writeByte(base+0x3F0, 0x0A)
-- PHS allowed + visible bit 7
local allowed = readSmallInteger(base+0x10A4) or 0
local visible = readSmallInteger(base+0x10A6) or 0
writeSmallInteger(base+0x10A4, allowed | 0x80)
writeSmallInteger(base+0x10A6, visible | 0x80)
-- Put Sephiroth in party slot 3
writeByte(base+0x4FA, 0x0A)
writeByte(base+0x0CAD+2, 0x0A)
showMessage("Sephiroth enabled (shares Vincent slot). Save in-game to keep it.")
[DISABLE]
</AssemblerScript>
        </CheatEntry>

      </CheatEntries>
    </CheatEntry>

