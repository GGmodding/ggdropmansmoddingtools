local function applyPos(p, loc, wide, px, py, pz, ox, oy, oz)
  writeVec(loc, px, py, pz, wide)
  local root = readQword(p + 0x1B8)
  if looksUObj(root) then
    writeVec(root + 0x148, px, py, pz, detectWide(root + 0x148))
    writeVec(root + 0x190, 0, 0, 0, true) -- ComponentVelocity
    for off = 0x1B0, 0x250, 8 do
      local tx, ty, tz = readVec(root + off, true)
      if looksPos(tx, ty, tz) then
        local dx = math.abs(tx - ox) + math.abs(ty - oy) + math.abs(tz - oz)
        if dx &lt; 120 then
          writeVec(root + off, px, py, pz, true)
          st.ctwOff = off
        end
      end
    end
    if st.ctwOff then writeVec(root + st.ctwOff, px, py, pz, true) end
  end
  local cap = readQword(p + 0x340)
  if looksUObj(cap) then
    local cLoc = cap + 0x148
    local w2 = detectWide(cLoc)
    local cx, cy, cz = readVec(cLoc, w2)
    if looksPos(cx, cy, cz) then writeVec(cLoc, px, py, pz, w2) end
  end
  local cmc = readQword(p + 0x1400)
  if looksUObj(cmc) then
    for _, lo in ipairs({0x2A0, 0x2B0, 0x2C0, 0x300, 0x310, 0x320}) do
      for _, w2 in ipairs({true, false}) do
        local tx, ty, tz = readVec(cmc + lo, w2)
        if looksPos(tx, ty, tz) then
          writeVec(cmc + lo, px, py, pz, w2)
          break
        end
      end
    end
    for _, lo in ipairs({0xD0, 0xE0, 0xF0, 0x100, 0x110, 0x120}) do
      local vx = readFloat(cmc + lo)
      local vy = readFloat(cmc + lo + 4)
      local vz = readFloat(cmc + lo + 8)
      if vx and vy and vz and math.abs(vx) + math.abs(vy) + math.abs(vz) &lt; 5000 then
        writeFloat(cmc + lo, 0)
        writeFloat(cmc + lo + 4, 0)
        writeFloat(cmc + lo + 8, 0)
      end
    end
  end
end

