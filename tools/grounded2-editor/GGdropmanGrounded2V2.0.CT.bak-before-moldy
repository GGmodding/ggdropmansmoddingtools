      st.locAddr = addr
      st.locWide = wide
      st.locTag = "Capsule+0x148"
      if not quiet then
        print(string.format("TP loc @ %X (%s) = %.1f %.1f %.1f", addr, st.locTag, x, y, z))
      end
      return addr, wide
    end
  end
  return nil
end

