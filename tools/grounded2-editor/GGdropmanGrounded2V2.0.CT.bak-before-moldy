    st.hold = { x = nx, y = ny, z = nz, left = 16, loc = loc, wide = wide }
    if st.holdTimer == nil then
      st.holdTimer = createTimer(nil, false)
      st.holdTimer.Interval = 20
      st.holdTimer.OnTimer = function()
        if st.hold == nil or st.hold.left &lt;= 0 then
