        end
        local pp = pawn()
        if not pp then return end
        local l2 = st.hold.loc
        local w2 = st.hold.wide or true
        if l2 then writeVec(l2, st.hold.x, st.hold.y, st.hold.z, w2) end
        local root = readQword(pp + 0x1B8)
        if looksUObj(root) then
          writeVec(root + 0x148, st.hold.x, st.hold.y, st.hold.z, true)
          if st.ctwOff then writeVec(root + st.ctwOff, st.hold.x, st.hold.y, st.hold.z, true) end
        end
        st.hold.left = st.hold.left - 1
      end
    end
    st.holdTimer.Enabled = true

    local rx, ry, rz = readVec(loc, wide)
    print(string.format(
      "TP (%s) yaw=%.1f pitch=%.1f dist=%.0f  %.1f,%.1f,%.1f -> %.1f,%.1f,%.1f (rb %.1f,%.1f,%.1f)",
      src or "?", yaw, pitch, st.dist, x, y, z, nx, ny, nz, rx, ry, rz))
