local function looksPos(x, y, z)
  if x == nil or y == nil or z == nil then return false end
  if not (x == x and y == y and z == z) then return false end
  local a = math.abs(x) + math.abs(y)
  return a &gt; 500 and a &lt; 5e6 and math.abs(z) &lt; 5e5
end

local function readVec(addr, wide)
  if wide then
    return readDouble(addr), readDouble(addr + 8), readDouble(addr + 16)
  end
  return readFloat(addr), readFloat(addr + 4), readFloat(addr + 8)
end

local function writeVec(addr, x, y, z, wide)
  if wide then
    writeDouble(addr, x)
    writeDouble(addr + 8, y)
    writeDouble(addr + 16, z)
  else
    writeFloat(addr, x)
    writeFloat(addr + 4, y)
    writeFloat(addr + 8, z)
  end
end

local function detectWide(addr)
  local dx, dy, dz = readVec(addr, true)
  if looksPos(dx, dy, dz) then return true end
  local fx, fy, fz = readVec(addr, false)
  if looksPos(fx, fy, fz) then return false end
