local function isSaneFloat(v, lo, hi)
  if v == nil or v ~= v then return false end -- nil or NaN
  if v == math.huge or v == -math.huge then return false end
  return v &gt;= lo and v &lt;= hi
end

local function pawnInfo(p)
  if not looksUObj(p) then return nil end
  local hc = readQword(p + 0x13A0)
  if not looksUObj(hc) then return nil end
  local mx = readFloat(hc + 0x318)
  local dmg = readFloat(hc + 0x31C)
  -- NaN must be rejected (Lua: NaN &lt; x is always false)
  if not isSaneFloat(mx, 10, 50000) then return nil end
  if not isSaneFloat(dmg, -1, 50000) then return nil end
  local sc = readQword(p + 0x13B8)
  local mst = looksUObj(sc) and readFloat(sc + 0xFC) or nil
  local cst = looksUObj(sc) and readFloat(sc + 0xF8) or nil
  local hasStam = isSaneFloat(mst, 5, 50000) and isSaneFloat(cst, 0, 50000)
  local sv = readQword(p + 0x14C8)
  local food = looksUObj(sv) and readFloat(sv + 0x288) or nil
  local water = looksUObj(sv) and readFloat(sv + 0x290) or nil
  local hasFood = isSaneFloat(food, 0.5, 100000) and isSaneFloat(water, 0, 100000)
  -- Require stamina and/or food so random HC-shaped objects don't match
  if not hasStam and not hasFood then return nil end
  local cmc = readQword(p + 0x1400)
  -- Local player heuristics (SDK): APawn::Controller @0x2E0, SurvivalPlayerCharacter::FPCOverlay @0x2020
  local ctrl = readQword(p + 0x2E0)
  local hasCtrl = looksUObj(ctrl)
  local possessed = false
  if hasCtrl then
    for _, o in ipairs({0x370, 0x308, 0x318, 0x2F8, 0x300, 0x2A0, 0x360}) do
      if readQword(ctrl + o) == p then possessed = true; break end
    end
  end
  local fpc = readQword(p + 0x2020)
  local isPlayerChar = looksUObj(fpc)
  local ps = readQword(p + 0x2D0)
  local hasPS = looksUObj(ps)
  return {
    pawn=p, hc=hc, max=mx, dmg=dmg,
    food=food, water=water, hasFood=hasFood, hasStam=hasStam,
    hasCmc=looksUObj(cmc),
    hasCtrl=hasCtrl, possessed=possessed, isPlayerChar=isPlayerChar, hasPS=hasPS,
  }
end

local function scorePawn(pi)
  if pi == nil then return -1 end
  local score = 0
  if pi.hasStam then score = score + 50 end
  if pi.hasFood then score = score + 50 end
  if pi.hasCmc then score = score + 20 end
  if isSaneFloat(pi.max, 50, 500) then score = score + 10 end
  if isSaneFloat(pi.dmg, 0, 500) then score = score + 5 end
  if pi.hasCtrl then score = score + 80 end
  if pi.possessed then score = score + 500 end
  if pi.isPlayerChar then score = score + 200 end
  if pi.hasPS then score = score + 40 end
  return score
end

local function findPawnOnPC(pc)
  if not looksUObj(pc) then return nil, nil end
  for _, o in ipairs({0x370, 0x308, 0x318, 0x2F8, 0x300, 0x310, 0x360, 0x368}) do
    local info = pawnInfo(readQword(pc + o))
    if info ~= nil then return info, string.format("PC+0x%X", o) end
  end
  return nil, nil
end

local function tryAsPawnOrOwner(obj, tag)
  local info = pawnInfo(obj)
  if info ~= nil then return info, tag.." asPawn" end
  local inf, sub = findPawnOnPC(obj)
  if inf ~= nil then return inf, tag.." "..tostring(sub) end
  local psPawn = readQword(obj + 0x328)
  info = pawnInfo(psPawn)
  if info ~= nil then return info, tag.."+0x328" end
  return nil, nil
end

-- Scan GI for real LocalPlayers TArray (num=1..4, element has usable PC/pawn)
local function scanGIForLocalPlayer(giObj)
  print("Scanning GI for LocalPlayers-like TArrays...")
  local bestLp, bestPc, bestInfo, bestTag = nil, nil, nil, nil
  local off = 0x28
  while off &lt;= 0x120 do
    local data = readQword(giObj + off)
    local num = readInteger(giObj + off + 8)
    if isHeapPtr(data) and num ~= nil and num &gt;= 1 and num &lt;= 4 then
      local elem = readQword(data)
      if looksUObj(elem) then
        local vp = readQword(elem + 0x78)
        print(string.format("  GI+0x%X TArray data=%X num=%d elem=%X vp78=%s",
          off, data, num, elem, looksUObj(vp) and string.format("%X", vp) or "no"))
        local eoff = 0x28
        while eoff &lt;= 0x120 do
          local v = readQword(elem + eoff)
          if looksUObj(v) then
            local info, sub = tryAsPawnOrOwner(v, string.format("GI+0x%X/LP+0x%X", off, eoff))
            if info ~= nil then
              print(string.format("    hit LP+0x%X -&gt; %s pawn=%X max=%.1f food=%s stam=%s",
                eoff, tostring(sub), info.pawn, info.max, tostring(info.hasFood), tostring(info.hasStam)))
              if bestInfo == nil or (info.hasFood and not bestInfo.hasFood) or (info.hasStam and not bestInfo.hasStam) then
                bestLp, bestPc, bestInfo, bestTag = elem, v, info, sub
              end
            end
          end
          eoff = eoff + 8
        end
        local info2, sub2 = tryAsPawnOrOwner(elem, string.format("GI+0x%X/elem", off))
        if info2 ~= nil and (bestInfo == nil or (info2.hasFood and not bestInfo.hasFood)) then
          bestLp, bestPc, bestInfo, bestTag = elem, elem, info2, sub2
        end
      end
    end
    off = off + 8
  end
  return bestInfo, bestTag, bestPc, bestLp
end

local function scanLevel(level, tagLvl)
  if not looksUObj(level) then
    print(string.format("  %s = nil/bad", tagLvl))
    return nil, nil
  end
  print(string.format("  %s = %X", tagLvl, level))
  local best, bestTag = nil, nil
  for _, aoff in ipairs({0xA0, 0x98, 0xA8, 0xB0}) do
    local data = readQword(level + aoff)
    local num = readInteger(level + aoff + 8)
    print(string.format("    Arr+0x%X data=%s num=%s", aoff,
      data and string.format("%X", data) or "nil", tostring(num)))
    if isHeapPtr(data) and num ~= nil and num &gt;= 1 and num &lt;= 20000 then
      local i = 0
      local lim = math.min(num, 8000)
      local survCount = 0
      while i &lt; lim do
        local actor = readQword(data + i * 8)
        local pi = pawnInfo(actor)
        if pi ~= nil then
          survCount = survCount + 1
          if pi.hasFood and pi.hasStam then
            print(string.format("    LOCAL surv Actors[%d]=%X max=%.1f food=%.1f", i, actor, pi.max, pi.food))
            return pi, tagLvl..string.format(" Actors[%d]", i)
          end
          if best == nil or (pi.hasFood and not best.hasFood) or (pi.hasStam and not best.hasStam) then
            best, bestTag = pi, tagLvl..string.format(" Actors[%d]", i)
          end
        end
        i = i + 1
      end
      print(string.format("    surv hits in this array: %d", survCount))
      break
    end
  end
  return best, bestTag
end

local function resolveOnWorld(world, gi, rva)
  print(string.format("--- try GWorld +%X world=%X gi=%s ---", rva, world, gi and string.format("%X", gi) or "nil"))
  -- Dump UWorld head (PersistentLevel should be near +0x30)
  print("  World field dump:")
  local plOff = nil
  local off = 0x28
  while off &lt;= 0x60 do
    local v = readQword(world + off)
    local ok = looksUObj(v)
    print(string.format("    World+0x%X = %s%s", off, v and string.format("%X", v) or "nil", ok and " UObj" or ""))
    if ok and plOff == nil then plOff = off end
    off = off + 8
  end

  local pawn, pawnTag, pc = nil, nil, nil
  if looksUObj(gi) then
    local info, tag, pcFound = scanGIForLocalPlayer(gi)
    if info ~= nil then
      pawn, pawnTag, pc = info.pawn, tag, pcFound
    end
  end
  if pawn == nil then
    print("Scanning World levels for SurvivalCharacter...")
    local pi, tg = scanLevel(readQword(world + 0x30), "PersistentLevel@30")
    if pi ~= nil then pawn, pawnTag = pi.pawn, tg end
    if pawn == nil and plOff ~= nil and plOff ~= 0x30 then
      pi, tg = scanLevel(readQword(world + plOff), string.format("PersistentLevel@%X", plOff))
      if pi ~= nil then pawn, pawnTag = pi.pawn, tg end
    end
    -- try every UObj in world head as a Level
    if pawn == nil then
      off = 0x28
      while off &lt;= 0x60 and pawn == nil do
        local v = readQword(world + off)
        if looksUObj(v) then
          pi, tg = scanLevel(v, string.format("World+0x%X", off))
          if pi ~= nil then pawn, pawnTag = pi.pawn, tg end
        end
        off = off + 8
      end
    end
  end
  if pawn == nil then
    local levels = readQword(world + 0x1D0)
    local n = readInteger(world + 0x1D8)
    print(string.format("World.Levels data=%s num=%s", levels and string.format("%X", levels) or "nil", tostring(n)))
    if isHeapPtr(levels) and n ~= nil and n &gt;= 1 and n &lt;= 512 then
      local i = 0
      while i &lt; n do
        local pi, tg = scanLevel(readQword(levels + i * 8), string.format("Levels[%d]", i))
        if pi ~= nil and pi.hasFood and pi.hasStam then
          pawn, pawnTag = pi.pawn, tg
          break
        elseif pi ~= nil and pawn == nil then
          pawn, pawnTag = pi.pawn, tg
        end
        i = i + 1
      end
    end
  end
  if pawn == nil then
    local sdata = readQword(world + 0x90)
    local snum = readInteger(world + 0x98)
    print(string.format("World.StreamingLevels data=%s num=%s", sdata and string.format("%X", sdata) or "nil", tostring(snum)))
    if isHeapPtr(sdata) and snum ~= nil and snum &gt;= 1 and snum &lt;= 1024 then
      local i = 0
      while i &lt; math.min(snum, 256) and pawn == nil do
        local streaming = readQword(sdata + i * 8)
        if looksUObj(streaming) then
          for _, lo in ipairs({0x148, 0x138, 0x150, 0x160, 0x128, 0x168}) do
            local lvl = readQword(streaming + lo)
            if looksUObj(lvl) then
              local pi, tg = scanLevel(lvl, string.format("Stream[%d]+0x%X", i, lo))
              if pi ~= nil and (pi.hasFood or pi.hasStam) then
                pawn, pawnTag = pi.pawn, tg
                break
              elseif pi ~= nil and pawn == nil then
                pawn, pawnTag = pi.pawn, tg
              end
            end
          end
        end
        i = i + 1
      end
    end
  end
  if pawn == nil and looksUObj(gi) then
    print("Deep-scanning GI pointers for SurvivalCharacter...")
    off = 0x28
    while off &lt;= 0x300 do
      local v = readQword(gi + off)
      if looksUObj(v) then
        local pi = pawnInfo(v)
        if pi ~= nil and (pi.hasFood or pi.hasStam) then
          pawn, pawnTag = pi.pawn, string.format("GI+0x%X", off)
          break
        end
        local so = 0x28
        while so &lt;= 0x400 do
          local s = readQword(v + so)
          pi = pawnInfo(s)
          if pi ~= nil and (pi.hasFood or pi.hasStam) then
            pawn, pawnTag = pi.pawn, string.format("GI+0x%X/+0x%X", off, so)
            break
          end
          local inf = findPawnOnPC(s)
          if inf ~= nil and (inf.hasFood or inf.hasStam) then
            pawn, pawnTag = inf.pawn, string.format("GI+0x%X/+0x%X asPC", off, so)
            break
          end
          so = so + 8
        end
        if pawn ~= nil then break end
      end
      off = off + 8
    end
  end
  return pawn, pawnTag, pc
end

local function findViaGObjects()
  -- Flat TUObjectArray (this build): Objects* @0, Max @8, Num @0xC, FUObjectItem size 0x18
  local go = getAddressSafe("GObjects")
  if go == nil then return nil, nil end
  local objects = readQword(go)
  local maxE = readInteger(go + 0x8)
  local numE = readInteger(go + 0xC)
  print(string.format("GObjects scan Objects=%s Max=%s Num=%s", objects and string.format("%X", objects) or "nil", tostring(maxE), tostring(numE)))
  if not isHeapPtr(objects) or numE == nil or numE &lt; 100 or numE &gt; 5000000 then
    print("GObjects array unusable")
    return nil, nil
  end
  local best, bestTag, bestScore = nil, nil, -1
  local lim = math.min(numE, 800000)
  local i = 0
  local checked = 0
  local hits = 0
  while i &lt; lim do
    local obj = readQword(objects + i * 0x18)
    -- must be live heap actor (reject module CDOs like 7FF446...)
    if isHeapPtr(obj) and looksUObj(obj) then
      checked = checked + 1
      local pi = pawnInfo(obj)
      if pi ~= nil then
        hits = hits + 1
        local score = scorePawn(pi)
        print(string.format("  GObj[%d]=%X max=%.1f food=%s stam=%s cmc=%s ctrl=%s possessed=%s playerChar=%s score=%d",
          i, obj, pi.max, tostring(pi.food), tostring(pi.hasStam), tostring(pi.hasCmc),
          tostring(pi.hasCtrl), tostring(pi.possessed), tostring(pi.isPlayerChar), score))
        if score &gt; bestScore then
          best, bestTag, bestScore = pi, string.format("GObjects[%d]", i), score
        end
        -- early exit only on strong local-player signal
