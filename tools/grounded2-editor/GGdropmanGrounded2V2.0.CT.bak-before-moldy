local function readByte(a)
  -- CE variants: table / string / fallback via int
  local ok, s = pcall(readBytes, a, 1, true)
  if ok and type(s) == "table" and s[1] ~= nil then return s[1] end
  ok, s = pcall(readBytes, a, 1, false)
  if ok and type(s) == "string" and #s &gt;= 1 then return string.byte(s, 1) end
  local i = readInteger(a)
  if i ~= nil then return i &amp; 0xFF end
  return nil
end
local function looksAnyUObj(ptr)
  if ptr == nil or ptr == 0 or ptr &lt; 0x10000 then return false end
  local vf = readQword(ptr)
  return vf ~= nil and vf &gt; 0x10000
end

local function looksLikeSettings(s)
  if not looksAnyUObj(s) then return false end
  local okBools = 0
  for off = 0x3A, 0x51 do
    local b = readByte(s + off)
    if b == nil then return false end
    if b &lt;= 1 then okBools = okBools + 1 end
  end
  if okBools &lt; 12 then return false end
  if not isSaneFloat(readFloat(s + 0x54), 0.01, 100) then return false end
  if not isSaneFloat(readFloat(s + 0x80), 0.0, 100) then return false end
  return true
end

-- InGameGameState: Party @0x308, ModeManager @0x318; both Outer back to GS
local function looksLikeGameState(gs)
  if not looksUObj(gs) then return false end
  local party = readQword(gs + 0x308)
  local mm = readQword(gs + 0x318)
  if not looksUObj(party) or not looksUObj(mm) then return false end
  if readQword(party + 0x20) ~= gs then return false end
  if readQword(mm + 0x20) ~= gs then return false end
  return true
end

local function modeFromGameState(gs)
  if not looksLikeGameState(gs) then return nil, nil end
  local mm = readQword(gs + 0x318)
  local s = readQword(mm + 0x138)
  if not looksLikeSettings(s) then s = nil end
  return s, mm
end

local function probePtr(label, p)
  if p == nil then print("  "..label.."=nil"); return end
  print(string.format("  %s=%X heap=%s uobj=%s", label, p, tostring(isHeapPtr(p)), tostring(looksUObj(p) or looksAnyUObj(p))))
end

local function findGameModeSettings()
  -- A) PlayerController -&gt; CachedPartyComponent @0xEA8 -&gt; Outer = GameState
  local pc = readQword(pawn + 0x2E0)
  probePtr("PC", pc)
  if looksUObj(pc) then
    local party = readQword(pc + 0xEA8)
    probePtr("PC.CachedParty", party)
    if looksUObj(party) then
      local gs = readQword(party + 0x20)
      probePtr("Party.Outer(GS?)", gs)
      local s, mm = modeFromGameState(gs)
      if mm ~= nil then return s, mm, "PC.CachedParty.Outer" end
      if looksUObj(gs) then
        print(string.format("  GS+0x308=%s GS+0x318=%s",
          tostring(readQword(gs + 0x308) and string.format("%X", readQword(gs + 0x308))),
          tostring(readQword(gs + 0x318) and string.format("%X", readQword(gs + 0x318)))))
      end
    end
  end

  -- B) Outer walk + Level.OwningWorld + World.GameState
  local cur = pawn
  for i = 1, 16 do
    if not looksUObj(cur) then break end
    print(string.format("  Outer[%d]=%X", i, cur))
    local s, mm = modeFromGameState(cur)
    if mm ~= nil then return s, mm, "asGameState" end
    local ownW = readQword(cur + 0xC0)
    if looksUObj(ownW) then
      probePtr("  Level.OwningWorld", ownW)
      s, mm = modeFromGameState(readQword(ownW + 0x1B0))
      if mm ~= nil then return s, mm, "Level.OwningWorld.GameState" end
      probePtr("  World.GameState", readQword(ownW + 0x1B0))
    end
    local gs = readQword(cur + 0x1B0)
    if looksUObj(gs) then
      probePtr("  +0x1B0", gs)
      s, mm = modeFromGameState(gs)
      if mm ~= nil then return s, mm, "Outer+0x1B0" end
    end
    cur = readQword(cur + 0x20)
  end

  -- C) GWorld candidates
  for i = 1, #worldCands do
    local gs = readQword(worldCands[i].world + 0x1B0)
    probePtr(string.format("GWorldCand+%X.GS", worldCands[i].rva), gs)
    local s, mm = modeFromGameState(gs)
    if mm ~= nil then return s, mm, string.format("GWorldCand+%X", worldCands[i].rva) end
  end

  -- D) GObjects: PartyComponent whose Outer looks like GameState
  print("Scanning GObjects for Party/GameState...")
  local go = getAddressSafe("GObjects")
  if go ~= nil then
    local objects = readQword(go)
    local numE = readInteger(go + 0xC)
    if isHeapPtr(objects) and numE ~= nil and numE &gt; 100 then
      local lim = math.min(numE, 800000)
      local i = 0
      local hits = 0
      while i &lt; lim do
        local obj = readQword(objects + i * 0x18)
        if looksUObj(obj) then
          local outer = readQword(obj + 0x20)
          -- Party: GameState+0x308 == this
          if looksUObj(outer) and readQword(outer + 0x308) == obj then
            hits = hits + 1
            local s, mm = modeFromGameState(outer)
            print(string.format("  Party-like GObj[%d]=%X Outer=%X mm=%s",
              i, obj, outer, mm and string.format("%X", mm) or "no"))
            if mm ~= nil then return s, mm, string.format("GObjects[%d] Party-&gt;GS", i) end
          end
        end
        i = i + 1
      end
      print(string.format("  Party-like hits=%d", hits))
    end
  end
  return nil, nil, nil
end

