  local root = readQword(obj + 0x1B8)
  if not looksUObj(root) then return false end
  local init = readInteger(obj + 0x96C) -- InitialCharges
  local hours = readInteger(obj + 0x978) -- HoursPerCharge
  local maxP = readInteger(obj + 0x968) -- MaxPowerCapacity
  local stored = readFloat(obj + 0x95C) -- PowerReservoir.ChargesStored
  local cap = readFloat(obj + 0x960) -- PowerReservoir.ChargeCapacity
  if init == nil or hours == nil or stored == nil or cap == nil then return false end
  if init &lt; 1 or init &gt; 32 then return false end
  if hours &lt; 0 or hours &gt; 168 then return false end
  if maxP ~= nil and (maxP &lt; 1 or maxP &gt; 64) then return false end
  if not (stored == stored and cap == cap) then return false end
