-- AActor::RootComponent @0x1B8, USceneComponent::RelativeLocation @0x148 (FVector 0x18)
local function findLoc(p, quiet)
  local root = readQword(p + 0x1B8)
  if looksUObj(root) then
    local addr = root + 0x148
    local wide = detectWide(addr)
    local x, y, z = readVec(addr, wide)
    if looksPos(x, y, z) then
      if not quiet and (st.locAddr ~= addr or st._lastLocPrint == nil) then
        print(string.format("TP loc @ %X (Root+0x148 wide=%s) = %.1f %.1f %.1f",
          addr, tostring(wide), x, y, z))
        st._lastLocPrint = true
      end
      st.locAddr = addr
      st.locWide = wide
      st.locTag = "Root+0x148"
      return addr, wide
    end
  end
  local cap = readQword(p + 0x340)
  if looksUObj(cap) then
    local addr = cap + 0x148
    local wide = detectWide(addr)
    local x, y, z = readVec(addr, wide)
