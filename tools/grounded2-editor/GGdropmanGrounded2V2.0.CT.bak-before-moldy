  -- Root RelativeRotation yaw (body facing) — updates when you turn
  local root = readQword(p + 0x1B8)
  if looksUObj(root) then
    for _, wide in ipairs({true, false}) do
      local pitch, yaw = readRot(root + 0x160, wide) -- RelativeRotation after RelativeLocation(0x148)+0x18
