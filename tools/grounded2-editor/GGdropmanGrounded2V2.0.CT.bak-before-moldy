-- APlayerCameraManager::CameraCachePrivate @0x1550 + POV @+0x10 = 0x1560 (SDK)
-- FMinimalViewInfo: Location@0 Rotator@0x18 (doubles)
local function readRot(addr, wide)
  if wide then
    return readDouble(addr), readDouble(addr + 8)
  end
  return readFloat(addr), readFloat(addr + 4)
end

local function rotOk(pitch, yaw)
  return pitch ~= nil and yaw ~= nil
    and pitch == pitch and yaw == yaw
    and math.abs(pitch) &lt;= 89.9 and math.abs(yaw) &lt;= 360.5
end

-- Horizontal blink from yaw only (pitch caused floor clips / void drops).
local function destFromAim(x, y, z, pitch, yaw, dist)
  local yr = math.rad(yaw)
  local nx = x + math.cos(yr) * dist
  local ny = y + math.sin(yr) * dist
  local lift = 200
  if pitch ~= nil and pitch &gt; 5 then
    lift = lift + math.min(800, (pitch - 5) * 25)
  end
  return nx, ny, z + lift
end

local function tryCamPov(cam, po, tag)
  -- Prefer doubles (UE5 FVector/FRotator are 0x18)
  for _, wide in ipairs({true, false}) do
    local lx, ly, lz = readVec(cam + po, wide)
    local stride = wide and 24 or 12
    local pitch, yaw = readRot(cam + po + stride, wide)
    if looksPos(lx, ly, lz) and rotOk(pitch, yaw) then
      -- FOV sanity when reading CameraCache (float at Loc+0x30)
      local fov = readFloat(cam + po + 0x30)
      if fov ~= nil and (fov &lt; 20 or fov &gt; 170) and tag == "CameraCache" then
        -- still allow if yaw looks live
      end
      st.camLoc = {lx, ly, lz}
      return pitch, yaw, tag
    end
  end
  return nil
end

local function findAim(p)
  st.camLoc = nil
  local ctrl = readQword(p + 0x2E0)
  if not looksUObj(ctrl) then
    print("TP aim: no Controller @ Player+0x2E0")
    return nil
  end

  local cam = readQword(ctrl + 0x380)
  if looksUObj(cam) then
    -- Exact SDK slots first (live look direction)
    local pitch, yaw, tag = tryCamPov(cam, 0x1560, "CameraCache")
    if pitch ~= nil then return pitch, yaw, tag end
    pitch, yaw, tag = tryCamPov(cam, 0x350, "ViewTarget") -- ViewTarget.POV @ 0x340+0x10
    if pitch ~= nil then return pitch, yaw, tag end
    pitch, yaw, tag = tryCamPov(cam, 0x1E40, "LastFrameCache") -- LastFrameCameraCachePrivate+0x10
    if pitch ~= nil then return pitch, yaw, tag end
