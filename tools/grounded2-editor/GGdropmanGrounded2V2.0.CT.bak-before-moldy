local function findModule()
  local prefer = {
    "Grounded2Steam-Win64-Shipping.exe",
    "Grounded2-Win64-Shipping.exe",
    "MaineSteam-Win64-Shipping.exe",
    "Maine-Win64-Shipping.exe",
  }
  for i=1,#prefer do
    if getAddressSafe(prefer[i]) ~= nil then return prefer[i] end
  end
  if getAddressSafe(process) ~= nil then return process end
  return nil
end

local function isHeapPtr(ptr)
  if ptr == nil or ptr == 0 or ptr &lt; 0x100000000 then return false end
  -- Live UE objects on this build are ~0x000001xxxxxxxx, NOT 0x00007FFxxxxxxxx (modules/CDOs)
  if ptr &gt;= 0x7F0000000000 then return false end
  local base = getAddressSafe(process)
  local size = getModuleSize(process)
  if base ~= nil and size ~= nil and ptr &gt;= base and ptr &lt; (base + size) then
    return false
  end
  return true
end

local function looksUObj(ptr)
  if not isHeapPtr(ptr) then return false end
  local vf = readQword(ptr)
  return vf ~= nil and vf &gt; 0x10000
end

local function clearSym(name)
  pcall(function()
    if getAddressSafe(name) ~= nil then
      unregisterSymbol(name)
    end
  end)
  pcall(function() autoAssemble("unregistersymbol("..name..")") end)
end

local function regAbs(name, addr)
  if addr == nil then return false end
  clearSym(name)
  pcall(function() registerSymbol(name, addr, true) end)
  return getAddressSafe(name) ~= nil
end

local function regModule(name, mod, rva)
  clearSym(name)
  local def = string.format("%s+%X", mod, rva)
  assert(autoAssemble("define("..name..","..def..")\nregistersymbol("..name..")"), "define "..name.." failed")
  local val = readQword(getAddress(name))
  print(string.format("%s = %s (mem=%s)", name, def, val and string.format("%X", val) or "nil"))
  return val
end

