{
  "name": "ggdropman-steam-achievement-unlocker",
  "version": "1.0.0",
  "private": true,
  "description": "Local Steam achievement list/unlock/lock CLI (requires Steam client + owned AppID)",
  "main": "unlock.js",
  "bin": {
    "gg-steam-achievements": "./unlock.js"
  },
  "scripts": {
    "list": "node unlock.js --list",
    "unlock-all": "node unlock.js --unlock-all",
    "lock-all": "node unlock.js --lock-all",
    "e33:list": "node unlock.js --app expedition33 --list",
    "e33:unlock-all": "node unlock.js --app expedition33 --unlock-all",
    "e33:lock-all": "node unlock.js --app expedition33 --lock-all"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  }
}
